# Copy this file to `.env` and fill in real values for local development.

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me

# PostgreSQL connection string used by the app at runtime.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://payments_user:payments_pass@localhost:5432/payments_db

# Logging
LOG_LEVEL=INFO
